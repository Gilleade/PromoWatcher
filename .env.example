# --- Telegram (MTProto) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Monitore somente estes chats (opcional). Separe por vírgulas.
# Pode ser @username do canal/grupo, ID numérico, ou deixe vazio para ouvir TODOS que você participa.
TELEGRAM_CHATS=

# Se quiser apenas alguns, deixe acima; se quiser TODOS os seus, deixe TELEGRAM_CHATS vazio.

# --- Palavras-chave ---
KEYWORDS_FILE=keywords.txt        # arquivo de palavras-chave (uma por linha)
CASE_INSENSITIVE=true             # true/false
ACCENT_INSENSITIVE=true           # true/false
NORMALIZE_SPACES_DASHES=true      # true/false  (trata "lava louças", "lava-louças", "lavaloucas")

# Cooldown/anti-spam
COOLDOWN_SECONDS=45               # evita alertas repetidos muito rápidos
DEDUP_WINDOW=600                 # segundos para ignorar repetições idênticas

# Janela silenciosa (opcional). Ex.: 23-07 silencia entre 23:00 e 07:59
SILENT_HOURS=                     # exemplo: 23-07   (deixe vazio para desativar)

# --- Entrega: Telegram ---
SEND_TO_TELEGRAM=true             # envia pra "Mensagens Salvas"
FORWARD_OR_COPY=copy           # forward (encaminhar original) | copy (texto formatado)

# Canal/DM para receber o alerta:
# Use @username do canal (público) OU o id numérico (para canal privado).
# Se deixar vazio, vai para 'me' (Mensagens Salvas).
NOTIFY_CHAT=

# --- Entrega: Email (opcional) ---
SEND_EMAIL=false                  # true para ativar
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha_de_app_ou_smtp
EMAIL_TO=seuemail@gmail.com
EMAIL_SUBJECT=[Promoções] Alerta de palavra-chave
