# --- Telegram (MTProto) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Monitore somente estes chats (opcional). Separe por vírgulas.
# Pode ser @username do canal/grupo, ID numérico, ou deixe vazio para ouvir TODOS que você participa.
TELEGRAM_CHATS=

# Se quiser apenas alguns, deixe acima; se quiser TODOS os seus, deixe TELEGRAM_CHATS vazio.

# --- Alertas e normalização de texto ---
ALERTS_FILE=alerts.json           # arquivo de alertas estruturados (ver docs/ALERTAS.md)
CASE_INSENSITIVE=true             # true/false
ACCENT_INSENSITIVE=true           # true/false
NORMALIZE_SPACES_DASHES=true      # true/false  (trata "lava louças", "lava-louças", "lavaloucas")

# --- Banco de dados ---
DB_PATH=data/promowatcher.sqlite3 # caminho do banco SQLite local

# Timeout (segundos) para resolver/seguir links encurtados
LINK_RESOLVE_TIMEOUT=5

# --- Imagens de produto (foto anexada à mensagem do Telegram) ---
IMAGES_DIR=data/images             # onde as fotos baixadas ficam salvas
MEDIA_DOWNLOAD_TIMEOUT=15          # timeout (segundos) pra baixar a foto

# --- IA local (Ollama) para desambiguação de produtos ---
# Opcional: se o Ollama não estiver rodando, o catálogo continua funcionando
# só com as regras determinísticas (mais itens caem na fila de revisão manual).
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EXTRACT_MODEL=qwen2.5:0.5b     # usado só pelo script de avaliação (model_eval.py)
OLLAMA_MATCH_MODEL=qwen3:4b-instruct  # usado na desambiguação real de produtos ambíguos
OLLAMA_TIMEOUT=20
OLLAMA_KEEP_ALIVE=5m                  # descarrega o modelo da VRAM após ficar ocioso

# Janela silenciosa (opcional). Ex.: 23-07 silencia entre 23:00 e 07:59
SILENT_HOURS=                     # exemplo: 23-07   (deixe vazio para desativar)

# --- Entrega: Telegram ---
SEND_TO_TELEGRAM=true             # envia pra "Mensagens Salvas"
FORWARD_OR_COPY=copy           # forward (encaminhar original) | copy (texto formatado)

# Canal/DM para receber o alerta:
# Use @username do canal (público) OU o id numérico (para canal privado).
# Se deixar vazio, vai para 'me' (Mensagens Salvas).
NOTIFY_CHAT=

# --- Entrega: Email (opcional) ---
SEND_EMAIL=false                  # true para ativar
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha_de_app_ou_smtp
EMAIL_TO=seuemail@gmail.com
EMAIL_SUBJECT=[Promoções] Alerta de palavra-chave
